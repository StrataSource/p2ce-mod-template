{
    // Modified from: https://github.com/ocornut/imgui/issues/707#issuecomment-468798935

    Font = "panorama/fonts/LexendDeca-Regular.ttf"
    FontSize = 16

    // Strata colors: https://github.com/StrataSource/strata-branding/blob/main/info_colors.txt
